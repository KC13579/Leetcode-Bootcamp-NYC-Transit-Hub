# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Public MTA feeds used by the demo. Override only for local testing.
MTA_STATIONS_URL=https://web.mta.info/developers/data/nyct/subway/Stations.csv
MTA_FEED_BASE_URL=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds
MTA_STATIC_GTFS_URL=https://rrgtfsfeeds.s3.amazonaws.com/gtfs_subway.zip

# Enable Routes API and Places API (New) in your own Google Cloud project.
# Keep this server key in backend/.env, not in the browser bundle.
GOOGLE_MAPS_API_KEY=

# Firebase project containing Authentication, Firestore and optional Cloud Messaging.
FIREBASE_PROJECT_ID=
# Absolute service-account JSON path; Application Default Credentials also work.
GOOGLE_APPLICATION_CREDENTIALS=

# Start the notification worker only after configuring Firebase and explicit subscriptions.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_INTERVAL_SECONDS=60
FEED_MAX_AGE_SECONDS=180
